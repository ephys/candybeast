[
  // Deep enemies (below Y 0, the ones that get the 1.5x health / 2x xp buff) drop nicer loot as a reward

  // Undead (zombie family) have a good chance to drop bonus iron, scaling with Looting
  {
    "mob": ["minecraft:zombie", "minecraft:husk", "minecraft:zombie_villager"],
    "maxheight": -1,
    "random": 0.5,
    "item": "minecraft:iron_ingot",
    "itemcount": "1/1-2/2-3"
  },

  // Undead miners have mining-themed bonus loot
  {
    "mob": "rottencreatures:undead_miner",
    "maxheight": -1,
    "item": ["minecraft:coal", "minecraft:raw_copper"],
    "itemcount": "1-2/2-3/3-4"
  },

  // Skeletons and strays drop more bones/arrows, and occasionally an emerald
  {
    "mob": ["minecraft:skeleton", "minecraft:stray"],
    "maxheight": -1,
    "item": ["minecraft:bone", "minecraft:arrow"],
    "itemcount": "2-3/3-4/4-6"
  },
  {
    "mob": ["minecraft:skeleton", "minecraft:stray"],
    "maxheight": -1,
    "random": 0.08,
    "item": "minecraft:emerald"
  },

  // Creepers drop more gunpowder, and sometimes a bonus TNT
  {
    "mob": "minecraft:creeper",
    "maxheight": -1,
    "item": "minecraft:gunpowder",
    "itemcount": "2-3/3-4/4-5"
  },
  {
    "mob": "minecraft:creeper",
    "maxheight": -1,
    "random": 0.15,
    "item": "minecraft:tnt"
  },

  // Spiders drop more string/spider eyes
  {
    "mob": "minecraft:spider",
    "maxheight": -1,
    "item": ["minecraft:string", "minecraft:spider_eye"],
    "itemcount": "2-3/3-4/4-5"
  },

  // Blitzes have a chance to drop bonus redstone
  {
    "mob": "thermal:blitz",
    "maxheight": -1,
    "random": 0.4,
    "item": "minecraft:redstone",
    "itemcount": "1-2/2-3/3-4"
  }
]